[Unit]
Description=George Han website with EKU
After=network.target

[Service]
Type=simple
User=georgehan
Group=georgehan
WorkingDirectory=/opt/georgehan
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --env-file=/opt/georgehan/.env /opt/georgehan/server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/georgehan/private
UMask=0077

[Install]
WantedBy=multi-user.target
